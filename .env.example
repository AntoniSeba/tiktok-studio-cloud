# TikTok Studio Cloud: copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4318
HOST=127.0.0.1
# public address, used in emails and password reset links
APP_URL=https://studio.soft-synergy.com
# SQLite file (default: data/cloud.db)
# DB_PATH=/home/admin/tiktok-studio-cloud/data/cloud.db

# AI setup assistant (OpenRouter). Without a key the "paste anything" path is hidden.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# models offered in the picker, comma separated
# OPENROUTER_MODELS=google/gemini-2.5-flash-lite,openai/gpt-5-nano,qwen/qwen3-235b-a22b-2507,deepseek/deepseek-v3.2

# Email through Brevo SMTP. Without these the mailer runs dry (logs only).
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
MAIL_FROM=TikTok Studio <no-reply@soft-synergy.com>

# Video generator: opencode + DeepSeek by default, or headless Claude Code (claude/sonnet, claude/opus)
GEN_MODEL=openrouter/deepseek/deepseek-v4-flash
# GEN_MODELS=openrouter/deepseek/deepseek-v4-flash,openrouter/deepseek/deepseek-v4-pro,claude/sonnet,claude/opus
# GEN_OPENROUTER_API_KEY=      # separate key with a spending limit: the job agent can read it
# GEN_ANTHROPIC_API_KEY=       # needed for claude/* models on a server
GEN_MAX_CONCURRENT=1
GEN_DAILY_LIMIT=25
GEN_MAX_QUEUED=40
GEN_TIMEOUT_MIN=75
# GEN_SANDBOX=docker           # every job in its own container (deploy/generator.Dockerfile)

# Agent tab (chat that runs the studio)
AGENT_MODEL=deepseek/deepseek-v4-flash

# B-roll z internetu dla generatora (darmowy klucz: https://www.pexels.com/api/). Bez klucza opcja b-roll jest wyłączona.
PEXELS_API_KEY=
